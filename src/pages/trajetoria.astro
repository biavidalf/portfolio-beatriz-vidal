---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n/types';
import TrajectoryHero from '../components/trajectory/TrajectoryHero.astro';
import ExperienceTimeline from '../components/trajectory/ExperienceTimeline.astro';
import EducationSection from '../components/trajectory/EducationSection.astro';
import ContributionsSection from '../components/trajectory/ContributionsSection.astro';
import CapabilitiesSection from '../components/trajectory/CapabilitiesSection.astro';
import TrajectoryCta from '../components/trajectory/TrajectoryCta.astro';
const locale: Locale = 'pt-BR';
---

<BaseLayout
  locale={locale}
  page="trajectory"
  title="Trajetória de Beatriz Vidal | Desenvolvimento e inovação"
  description="Da formação técnica em Informática à coordenação de inovação, conheça a trajetória de Beatriz Vidal em desenvolvimento, produtos digitais e trabalho voluntário."
  socialTitle="Trajetória de Beatriz Vidal | Desenvolvimento e inovação"
  socialDescription="Da formação técnica à coordenação de inovação: conheça minha experiência em desenvolvimento, produtos digitais e trabalho voluntário."
  socialImage="/assets/share-trajetoria.png"
  socialImageAlt="Trajetória de Beatriz Vidal. Uma trajetória feita de ideias em movimento."
  themeColor="#151513"
>
  <main id="conteudo">
    <TrajectoryHero locale={locale} />

    <ExperienceTimeline locale={locale} />

    <EducationSection locale={locale} />

    <ContributionsSection locale={locale} />

    <CapabilitiesSection locale={locale} />

    <TrajectoryCta locale={locale} />
  </main>
</BaseLayout>
