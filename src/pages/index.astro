---
import WorkMethod from '../components/WorkMethod.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://portfolio-beatriz-vidal.vercel.app/#website',
      url: 'https://portfolio-beatriz-vidal.vercel.app/',
      name: 'Beatriz Vidal',
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'Person',
      '@id': 'https://portfolio-beatriz-vidal.vercel.app/#beatriz',
      name: 'Beatriz Vidal',
      url: 'https://portfolio-beatriz-vidal.vercel.app/',
      jobTitle: 'Desenvolvedora e coordenadora de inovação',
      sameAs: [
        'https://www.instagram.com/biavidalf/',
        'https://www.linkedin.com/in/beatriz-vidal-bf4/',
        'https://www.tiktok.com/@_vidalb',
        'https://github.com/biavidalf',
      ],
    },
  ],
};
---

<BaseLayout
  page="home"
  title="Beatriz Vidal | Produtos digitais e inovação"
  description="Sou Beatriz Vidal. Desenvolvo aplicações, coordeno iniciativas de inovação e transformo desafios reais em produtos digitais. Conheça meu trabalho e vamos conversar."
  socialTitle="Beatriz Vidal | Produtos digitais e inovação"
  socialDescription="Te ajudo a transformar desafios reais em produtos digitais. Conheça meu trabalho em desenvolvimento e inovação e vamos conversar."
  socialImage="/assets/share-home.png"
  socialImageAlt="Beatriz Vidal. Te ajudo a transformar desafios reais em produtos digitais."
  themeColor="#F0ECE3"
  structuredData={structuredData}
>
<main id="conteudo">
    <section class="hero wrap" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="red-square" aria-hidden="true"></span> Entre ideias · pessoas · tecnologia</p>
        <h1 id="hero-title" aria-label="Te ajudo a transformar desafios reais em produtos digitais.">
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 0">Te</span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 1">ajudo</span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 2">a</span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 3"><em>transformar</em></span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 4">desafios</span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 5">reais</span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 6">em</span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 7"><strong>produtos</strong></span></span>
          <span class="hero-word" aria-hidden="true"><span style="--word-index: 8"><strong>digitais.</strong></span></span>
        </h1>
        <p class="hero-intro">Sinta-se em casa! Me chamo <strong>Beatriz Vidal</strong>. Desenvolvo aplicações e coordeno iniciativas de inovação, conectando pessoas e tecnologia para fazer boas ideias acontecerem.</p>
        <div class="hero-actions">
          <a class="button button-red" id="hero-email" href="mailto:beatrizvidal.dev@gmail.com?subject=Vim%20do%20seu%20portf%C3%B3lio%20e%20quero%20conversar">Conversar por e-mail <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a>
          <a class="text-link" id="hero-projects" href="#projetos">Conheça meu trabalho <span class="icon icon-arrow-down" aria-hidden="true"></span></a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="photo-frame">
          <img class="hero-photo" src="/assets/beatriz-conversa.webp" width="1400" height="933" alt="Beatriz sorrindo durante uma conversa em um evento de tecnologia." fetchpriority="high">
          <div class="photo-caption"><span class="icon icon-arrow-up-right caption-mark" aria-hidden="true"></span><p>É sobre tecnologia.<br><strong>E sobre quem está do outro lado.</strong></p></div>
        </div>
        <div class="photo-meta"><span>Boas trocas, dentro e fora da tela.</span><span aria-hidden="true">[ BV ]</span></div>
      </div>
      <div class="hero-bottom"><p>Recifense, vivendo em Fortaleza.</p><p>Desenvolvedora <span aria-hidden="true">/</span> Coordenadora de inovação</p></div>
    </section>

    <section class="projects wrap section-space" id="projetos" aria-labelledby="projects-title">
      <div class="section-heading work-heading">
        <p class="eyebrow">01 / Trabalho selecionado</p>
        <div><h2 id="projects-title">Produtos &amp; <em>cases.</em></h2><p class="section-intro">Produtos digitais para necessidades reais e soluções já aplicadas em diferentes contextos.</p></div>
      </div>
      <div class="work-tabs" role="tablist" aria-label="Produtos e cases selecionados">
        <button class="work-tab is-active" id="tab-produtos" type="button" role="tab" aria-selected="true" aria-controls="panel-produtos" tabindex="0"><span>Produtos</span></button>
        <button class="work-tab" id="tab-cases" type="button" role="tab" aria-selected="false" aria-controls="panel-cases" tabindex="-1"><span>Cases</span></button>
      </div>
      <div class="work-panel" id="panel-produtos" role="tabpanel" aria-labelledby="tab-produtos" tabindex="0">
        <article class="featured-project">
          <div class="mascot-stage">
            <span class="stage-caption">Lil Mascot / Companheiro de desktop</span>
            <span class="orbit orbit-one" aria-hidden="true"></span><span class="orbit orbit-two" aria-hidden="true"></span>
            <img src="/assets/lil-mascot.webp" alt="Personagem do Lil Mascot: pequeno arqueiro com capuz claro e roupa verde." width="600" height="600" loading="lazy">
            <span class="stage-note">um pequeno passo de cada vez</span>
          </div>
          <div class="project-copy">
            <p class="eyebrow project-status"><span class="red-square" aria-hidden="true"></span> Produto · organização e foco</p>
            <h3>Lil Mascot</h3>
            <p>Um companheiro de desktop para guardar ideias, organizar pequenos passos e começar momentos de foco.</p>
            <p>Nasceu de uma dificuldade minha e de estudos que fiz. É o produto a que mais me dediquei e que hoje uso no meu dia a dia.</p>
            <a class="text-link" id="lil-mascot-link" href="https://github.com/biavidalf/lil-mascot" target="_blank" rel="noopener noreferrer">Conhecer o produto <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a>
          </div>
        </article>
        <div class="work-accordions">
          <details class="work-accordion">
            <summary class="accordion-trigger"><span class="project-number" aria-hidden="true">02</span><span class="accordion-title"><span class="accordion-title-line"><strong>TumTumPá</strong><span class="company-badge">Neural Systems</span></span><small>Repertório, modo palco e comunidade musical</small></span><span class="accordion-summary">Cifras, setlists e banda no mesmo tempo.</span><span class="accordion-toggle" aria-hidden="true"></span></summary>
            <div class="accordion-content"><div class="detail-grid">
              <div><span class="eyebrow">O desafio</span><p>Manter cifras, ordem do show e músicos alinhados durante o ensaio e a apresentação.</p></div>
              <div><span class="eyebrow">Como funciona</span><p>Organiza repertórios e setlists compartilhadas, transpõe cifras e sincroniza a letra no modo palco. O mural também aproxima bandas e músicos por cidade, instrumento e objetivo.</p></div>
              <div><span class="eyebrow">Em evolução</span><p>Os classificados de instrumentos e equipamentos ainda estão em desenvolvimento.</p></div>
            </div><a class="text-link" href="https://tumtumpa.vercel.app/" target="_blank" rel="noopener noreferrer">Explorar TumTumPá <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a></div>
          </details>
          <details class="work-accordion">
            <summary class="accordion-trigger"><span class="project-number" aria-hidden="true">03</span><span class="accordion-title"><span class="accordion-title-line"><strong>BeHire</strong><span class="company-badge">Neural Systems</span></span><small>Marketing com IA orientada pela marca</small></span><span class="accordion-summary">Estratégia, produção e aprovação num só ciclo.</span><span class="accordion-toggle" aria-hidden="true"></span></summary>
            <div class="accordion-content"><div class="detail-grid">
              <div><span class="eyebrow">O desafio</span><p>Transformar a identidade de uma marca em conteúdo consistente sem perder contexto, tom de voz ou controle editorial.</p></div>
              <div><span class="eyebrow">Como funciona</span><p>Um perfil de marca orienta a estratégia e o calendário. A IA ajuda a produzir textos, carrosséis e imagens; pessoas revisam, aprovam e agendam as publicações.</p></div>
              <div><span class="eyebrow">Controle editorial</span><p>O fluxo registra revisões e aprovações, mantendo o histórico das decisões da equipe.</p></div>
            </div><a class="text-link" href="https://app.behire.com.br/" target="_blank" rel="noopener noreferrer">Conhecer a BeHire <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a></div>
          </details>
        </div>
      </div>
      <div class="work-panel" id="panel-cases" role="tabpanel" aria-labelledby="tab-cases" tabindex="0" hidden>
        <article class="featured-project">
          <div class="featured-media">
            <video class="featured-video motion-preview" autoplay muted loop playsinline preload="metadata" poster="/assets/preview-moldiax-site.webp" aria-label="Prévia em vídeo do site institucional da Moldsoft">
              <source src="/assets/preview-moldiax-demo.mp4" type="video/mp4">
            </video>
          </div>
          <div class="project-copy">
            <p class="eyebrow project-status"><span class="red-square" aria-hidden="true"></span> Experiência digital</p>
            <h3>Site institucional <span class="company-badge">Moldsoft Tecnologia</span></h3>
            <p>Desenvolvi o site institucional da Moldsoft para apresentar a empresa, suas soluções e as diferentes frentes em que atua.</p>
            <p>A experiência ajuda quem chega ao site a conhecer o trabalho da Moldsoft e encontrar o caminho para uma conversa.</p>
            <a class="text-link" href="https://moldsoft.com.br/" target="_blank" rel="noopener noreferrer">Visitar o site <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a>
          </div>
        </article>
        <div class="work-accordions case-accordions">
          <details class="work-accordion">
            <summary class="accordion-trigger"><span class="project-number" aria-hidden="true">02</span><span class="accordion-title"><span class="accordion-title-line"><strong>Try-On</strong><span class="company-badge">MoldIAX Tecnologia</span></span><small>Provador virtual e plataforma de varejo</small></span><span class="accordion-summary">Ajuda clientes a experimentar e escolher peças online.</span><span class="accordion-toggle" aria-hidden="true"></span></summary>
            <div class="accordion-content"><div class="tryon-case-layout">
              <video class="motion-preview tryon-video" autoplay muted loop playsinline preload="metadata" poster="/assets/preview-tryon.webp" aria-label="Prévia em vídeo da plataforma Try-On">
                <source src="/assets/preview-tryon-demo.mp4" type="video/mp4">
              </video>
              <div class="detail-grid">
              <div><span class="eyebrow">O desafio</span><p>Comprar roupa online sem saber como ela veste gera dúvida. Para as lojas, também é importante apresentar as peças, divulgar o catálogo e acompanhar as vendas.</p></div>
              <div><span class="eyebrow">A solução</span><p>O Try-On reúne provador virtual, catálogos com IA, loja online, estoque, pedidos e indicadores. Lojistas também podem criar posts com IA, escolhendo formato, modelo visual e detalhes da marca antes de baixar o conteúdo.</p></div>
              <div><span class="eyebrow">Minha contribuição</span><p>Participei da ideação e da estratégia do Try-On e sigo à frente da sua evolução desde o MVP. Coordeno o trabalho do time, reviso escopo e especificações e acompanho a qualidade das novas entregas. Também converso com lojistas que usam a plataforma e levo o que aprendemos com eles para as próximas versões.</p></div>
              </div>
            </div><a class="text-link" href="https://tryon.moldiax.com.br/" target="_blank" rel="noopener noreferrer">Explorar o Try-On <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a></div>
          </details>
          <details class="work-accordion">
            <summary class="accordion-trigger"><span class="project-number" aria-hidden="true">03</span><span class="accordion-title"><span class="accordion-title-line"><strong>Segurança operacional em refinaria</strong><span class="company-badge">MoldIAX Tecnologia</span></span><small>Visão computacional · refinaria de grande porte no Brasil</small></span><span class="accordion-summary">Detecção de EPI e acompanhamento de produtividade.</span><span class="accordion-toggle" aria-hidden="true"></span></summary>
            <div class="accordion-content"><div class="detail-grid">
              <div><span class="eyebrow">O desafio</span><p>Inspeções manuais dificultavam perceber continuamente a ausência de equipamentos de proteção em áreas críticas.</p></div>
              <div><span class="eyebrow">Estratégia de entrada</span><p>Começamos com um escopo menor e fechado, além de condições comerciais negociáveis, para viabilizar a entrada em um cliente de grande porte.</p></div>
              <div><span class="eyebrow">Expansão da solução</span><p>O projeto começou com detecção de EPI e abriu caminho para novas aplicações no mesmo cliente: produtividade, comparação de pesagens de caminhões, uso de celular e lavagem de mãos.</p></div>
              <div><span class="eyebrow">Minha contribuição</span><p>Participei da ideação e da estratégia da solução, acompanhei a implantação na refinaria e sigo conduzindo a evolução do projeto junto ao cliente. Coordeno o time nas novas aplicações e ajudo a transformar as necessidades da operação em próximos passos para o produto.</p></div>
            </div></div>
          </details>
        </div>
      </div>
    </section>

    <WorkMethod />

    <section class="about wrap section-space" id="sobre" aria-labelledby="about-title">
      <div class="about-copy">
        <p class="eyebrow">03 / Um pouco de mim</p>
        <h2 id="about-title">Gosto de construir.<br><em>E de <span class="about-together">construir junto.</span></em></h2>
        <p>Entre código, produtos e conversas, gosto de entender o que as pessoas precisam e encontrar caminhos para fazer acontecer. Sou afetuosa nas relações e objetiva na hora de resolver um problema.</p>
        <div class="about-affiliations" aria-label="Atuação profissional">
          <a class="about-affiliation" href="https://app.behire.com.br/" target="_blank" rel="noopener noreferrer"><span class="icon icon-arrow-up-right about-affiliation-mark" aria-hidden="true"></span><div class="about-affiliation-copy"><h3>Neural Systems</h3><p>Cofundadora · desenvolvimento de produtos digitais</p><span class="about-affiliation-destination">Conhecer a BeHire</span></div></a>
          <a class="about-affiliation" href="https://moldsoft.com.br/" target="_blank" rel="noopener noreferrer"><span class="icon icon-arrow-up-right about-affiliation-mark" aria-hidden="true"></span><div class="about-affiliation-copy"><h3>Moldsoft Tecnologia</h3><p>Coordenadora da vertente de inovação</p><span class="about-affiliation-destination">Visitar a Moldsoft</span></div></a>
        </div>
        <p class="about-personal">Fora das telas: amigos, família, arco e flecha e um olhar curioso para a cidade.</p>
        <div class="education"><span class="icon icon-corner-down-right" aria-hidden="true"></span><p>Técnico em Informática · IFCE<br>Análise e Desenvolvimento de Sistemas · Unifor</p></div>
        
        <a class="text-link about-trajectory-link" href="/trajetoria.html" style="margin-top: 14px">Conheça minha trajetória <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a>
      </div>
      <div class="about-image">
        <img src="/assets/beatriz-apresentando.webp" width="1800" height="1013" alt="Beatriz apresentando uma aplicação para um grupo de pessoas em um evento." loading="lazy">
        <p class="image-caption">Compartilhar também faz parte do meu trabalho.</p>
      </div>
    </section>

    <section class="event-gallery section-space" id="encontros" aria-labelledby="gallery-title">
      <div class="gallery-inner wrap">
        <div class="section-heading gallery-heading">
          <p class="eyebrow">04 / Encontros &amp; trocas</p>
          <div><h2 id="gallery-title">Transformando <em>complexidade técnica</em> <strong>em comunicação envolvente</strong></h2><p class="section-intro">Apresentação das aplicações desenvolvidas em eventos estratégicos do setor, onde transformo complexidade técnica em comunicação clara e envolvente, conectando inovação com oportunidades reais de mercado</p></div>
        </div>
        <section class="splide event-carousel" id="event-carousel" aria-labelledby="gallery-title" tabindex="0">
          <div class="splide__track">
            <ul class="splide__list">
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-presenting.webp" width="1800" height="1013" alt="Beatriz apresenta uma demonstração em uma tela azul durante um evento de tecnologia." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-conversation.webp" width="1800" height="1200" alt="Beatriz conversa com participantes em um encontro de tecnologia." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-demo-visitor.webp" width="1800" height="1200" alt="Beatriz apresenta uma solução digital a uma visitante em um estande." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-guided-tour.webp" width="1280" height="720" alt="Beatriz apresenta uma solução para um grupo de visitantes." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-fiec-team.webp" width="1800" height="1350" alt="Beatriz e colegas da Moldsoft em um evento no estande da FIEC." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-moldia-team.webp" width="1800" height="1200" alt="Beatriz e colegas apresentam o Mold IA X em um evento." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-unifor-team.webp" width="1800" height="1180" alt="Beatriz e colegas junto a uma demonstração do Mold IA X na Unifor." loading="lazy"></div></li>
              <li class="splide__slide event-card"><div class="event-image"><img src="/assets/event-team.webp" width="1800" height="1200" alt="Beatriz com colegas durante um evento de tecnologia." loading="lazy"></div></li>
            </ul>
          </div>
          <div class="gallery-pagination" aria-label="Controles do carrossel" hidden>
            <button class="gallery-toggle" type="button" aria-label="Pausar carrossel" aria-pressed="false">
            <svg class="pause-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            <svg class="play-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="m5 3 7 5-7 5z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            <span class="gallery-toggle-label">Pausar</span>
          </button>
          </div>
        </section>
      </div>
    </section>

    <section class="contact section-space" id="contato" aria-labelledby="contact-title">
      <div class="contact-inner wrap">
        <div class="contact-invitation">
          <p class="eyebrow">05 / Vamos começar</p>
          <h2 id="contact-title">Uma boa conversa<br>pode ser <em>o começo.</em></h2>
          <p>Escolha o canal que preferir para falar de oportunidades, produtos, parcerias ou simplesmente trocar ideia.</p>
          <img class="city-sketch" src="/assets/urban-sketch.webp" width="1536" height="1024" alt="" loading="lazy" aria-hidden="true">
        </div>
        <div class="contact-links">
          <a class="contact-item instagram-contact" id="contact-instagram" href="https://www.instagram.com/biavidalf/" target="_blank" rel="noopener noreferrer"><span><span class="contact-label">Instagram</span><span class="contact-detail">@biavidalf · mande um oi ou acompanhe os bastidores</span></span><span class="icon icon-arrow-up-right contact-arrow" aria-hidden="true"></span></a>
          <a class="contact-item" id="contact-whatsapp" href="https://wa.me/5585997008387" target="_blank" rel="noopener noreferrer"><span><span class="contact-label">WhatsApp</span><span class="contact-detail">Conversa direta sobre oportunidades, ideias e parcerias · +55 85 99700-8387</span></span><span class="icon icon-arrow-up-right contact-arrow" aria-hidden="true"></span></a>
          <a class="contact-item" id="contact-linkedin" href="https://www.linkedin.com/in/beatriz-vidal-bf4/" target="_blank" rel="noopener noreferrer"><span><span class="contact-label">LinkedIn</span><span class="contact-detail">Vamos nos conectar para falar de tecnologia, inovação e liderança.</span></span><span class="icon icon-arrow-up-right contact-arrow" aria-hidden="true"></span></a>
          <div class="email-row">
            <a class="contact-item" id="contact-email" href="mailto:beatrizvidal.dev@gmail.com"><span><span class="contact-label">E-mail</span><span class="contact-detail email-address">Convites, oportunidades e conversas com mais contexto · beatrizvidal.dev@gmail.com</span></span><span class="icon icon-arrow-up-right contact-arrow" aria-hidden="true"></span></a>
            <button class="copy-email" type="button" aria-label="Copiar endereço de e-mail" hidden>Copiar</button>
          </div>
          <a class="contact-item" id="contact-tiktok" href="https://www.tiktok.com/@_vidalb" target="_blank" rel="noopener noreferrer"><span><span class="contact-label">TikTok</span><span class="contact-detail">@_vidalb · acompanhe meus conteúdos e bastidores</span></span><span class="icon icon-arrow-up-right contact-arrow" aria-hidden="true"></span></a>
          <div class="contact-footnote"><p>Prefere conversar por voz?</p><a id="contact-phone" href="tel:+5585997008387">Me ligue · +55 85 99700-8387 <span class="icon icon-arrow-up-right" aria-hidden="true"></span></a></div>
          <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
