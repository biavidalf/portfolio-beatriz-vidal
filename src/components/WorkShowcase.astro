---
import '../styles/work-showcase.css';
import ProjectAccordion from './ProjectAccordion.astro';
import { getLocalizedContent, defaultLocale, type Locale } from '../i18n/types';
import { projectContent } from '../content/projects';
import { workShowcaseCopy } from '../content/work-showcase-copy';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const projects = getLocalizedContent(projectContent, locale);
const copy = getLocalizedContent(workShowcaseCopy, locale);
---

<section
  class="projects page-wrap pt-[105px] md:pt-[75px] max-sm:pt-[65px]"
  id="projetos"
  aria-labelledby="projects-title"
>
  <div class="section-heading work-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <div>
      <h2 id="projects-title">
        {copy.headingFirst} <em>{copy.headingEmphasis}</em>
      </h2>
      <p class="section-intro">{copy.introduction}</p>
    </div>
  </div>

  <div class="work-tabs-anchor" aria-hidden="true"></div>
  <div class="work-tabs" role="tablist" aria-label={copy.tabsLabel}>
    <button
      class="work-tab is-active"
      id="tab-cases"
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="panel-cases"
      tabindex="0"
    >
      <span>{copy.casesTab}</span>
    </button>
    <button
      class="work-tab"
      id="tab-produtos"
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-produtos"
      tabindex="-1"
    >
      <span>{copy.productsTab}</span>
    </button>
  </div>

  <div class="work-panel" id="panel-cases" role="tabpanel" aria-labelledby="tab-cases" tabindex="0">
    <article class="featured-project refinery-project">
      <div class="refinery-stage">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/assets/refinery-vision-computer.png"
          aria-label={copy.refinery.videoAlt}
        >
          <source src="/assets/refinery-epi-detection.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="project-copy">
        <p class="eyebrow project-status">
          <span class="red-square" aria-hidden="true"></span> {copy.refinery.eyebrow}
        </p>
        <h3>{copy.refinery.title}</h3>
        {copy.refinery.description.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <ul class="project-tag-list" aria-label={copy.refinery.tagsLabel}>
          {copy.refinery.tags.map((tag, index) => (
            <li class:list={['project-tag', { 'project-tag-primary': index === 0 }]}>{tag}</li>
          ))}
        </ul>
        <a
          class="text-link"
          href="https://moldiax.moldsoft.com.br/conteudos/moldblog/0"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.refinery.blogLink} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </div>
      <div class="featured-details">
        <div class="detail-grid">
          {copy.refinery.details.map((detail) => (
            <div>
              <span class="eyebrow">{detail.heading}</span>
              <p>{detail.description}</p>
            </div>
          ))}
        </div>
      </div>
    </article>

    <div class="work-accordions case-accordions">
      <ProjectAccordion project={projects.tryOn}>
        <div class="tryon-case-layout">
          <video
            class="motion-preview tryon-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/assets/preview-tryon.webp"
            aria-label={copy.tryOn.videoAlt}
          >
            <source src="/assets/preview-tryon-demo.mp4" type="video/mp4" />
          </video>
          <div class="detail-grid">
            {copy.tryOn.details.map((detail) => (
              <div>
                <span class="eyebrow">{detail.heading}</span>
                <p>{detail.description}</p>
              </div>
            ))}
          </div>
        </div>
        <p class="project-tech-note">
          <strong>{copy.technologyLabel}</strong> {copy.tryOn.techNote}
        </p>
        <a
          class="text-link"
          href="https://tryon.moldiax.com.br/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.tryOn.link} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </ProjectAccordion>
    </div>
  </div>

  <div
    class="work-panel"
    id="panel-produtos"
    role="tabpanel"
    aria-labelledby="tab-produtos"
    tabindex="0"
    hidden
  >
    <article class="featured-project">
      <div class="mascot-stage">
        <span class="stage-caption">{copy.mascot.stageCaption}</span>
        <span class="orbit orbit-one" aria-hidden="true"></span>
        <span class="orbit orbit-two" aria-hidden="true"></span>
        <img
          src="/assets/lil-mascot.webp"
          alt={copy.mascot.imageAlt}
          width="600"
          height="600"
          loading="lazy"
        />
        <span class="stage-note">{copy.mascot.stageNote}</span>
      </div>
      <div class="project-copy">
        <p class="eyebrow project-status">
          <span class="red-square" aria-hidden="true"></span> {copy.mascot.status}
        </p>
        <h3>Lil Mascot</h3>
        {copy.mascot.description.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        <ul class="project-tag-list" aria-label={copy.mascot.tagsLabel}>
          {copy.mascot.tags.map((tag, index) => (
            <li class:list={['project-tag', { 'project-tag-primary': index === 0 }]}>{tag}</li>
          ))}
        </ul>
        <a
          class="text-link"
          id="lil-mascot-link"
          href="https://github.com/biavidalf/lil-mascot"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.mascot.link} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </div>
      <div class="featured-details">
        <div class="detail-grid">
          {copy.mascot.details.map((detail) => (
            <div>
              <span class="eyebrow">{detail.heading}</span>
              <p>{detail.description}</p>
            </div>
          ))}
        </div>
      </div>
    </article>

    <div class="work-accordions">
      <ProjectAccordion project={projects.moldsoftSite}>
        <div class="project-media-layout">
          <video
            class="motion-preview project-preview-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/assets/preview-moldiax-site.webp"
            aria-label={copy.moldsoftSite.videoAlt}
          >
            <source src="/assets/preview-moldiax-demo.mp4" type="video/mp4" />
          </video>
          <div class="detail-grid">
            {copy.moldsoftSite.details.map((detail) => (
              <div>
                <span class="eyebrow">{detail.heading}</span>
                <p>{detail.description}</p>
              </div>
            ))}
          </div>
        </div>
        <ol class="project-flow" aria-label={copy.moldsoftSite.flowLabel}>
          {copy.moldsoftSite.flowSteps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <p class="project-tech-note">
          <strong>{copy.technologyLabel}</strong> {copy.moldsoftSite.techNote}
        </p>
        <a
          class="text-link"
          href="https://moldsoft.com.br/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.moldsoftSite.link} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </ProjectAccordion>
      <ProjectAccordion project={projects.tumtumpa}>
        <div class="detail-grid">
          {copy.tumtumpa.details.map((detail) => (
            <div>
              <span class="eyebrow">{detail.heading}</span>
              <p>{detail.description}</p>
            </div>
          ))}
        </div>
        <p class="project-tech-note">
          <strong>{copy.technologyLabel}</strong> {copy.tumtumpa.techNote}
        </p>
        <a
          class="text-link"
          href="https://tumtumpa.vercel.app/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.tumtumpa.link} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </ProjectAccordion>
      <ProjectAccordion project={projects.behire}>
        <div class="detail-grid">
          {copy.behire.details.map((detail) => (
            <div>
              <span class="eyebrow">{detail.heading}</span>
              <p>{detail.description}</p>
            </div>
          ))}
        </div>
        <p class="project-tech-note">
          <strong>{copy.technologyLabel}</strong> {copy.behire.techNote}
        </p>
        <a
          class="text-link"
          href="https://app.behire.com.br/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.behire.link} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </ProjectAccordion>
    </div>
  </div>
</section>

<script src="../scripts/work-showcase.js"></script>
