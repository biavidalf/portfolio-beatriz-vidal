---
import '../../styles/event-gallery.css';
import { getLocalizedContent, defaultLocale, type Locale } from '../../i18n/types';
import { homeCopy } from '../../content/home-copy';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const { gallery: copy } = getLocalizedContent(homeCopy, locale);
---

<section class="event-gallery" id="encontros" aria-labelledby="gallery-title">
  <div class="gallery-inner page-wrap">
    <div class="section-heading gallery-heading">
      <p class="eyebrow">{copy.eyebrow}</p>
      <div>
        <h2 id="gallery-title">
          {copy.titleFirst} <em>{copy.titleEmphasis}</em> <strong>{copy.titleStrong}</strong>
        </h2>
        <p class="section-intro">{copy.introduction}</p>
      </div>
    </div>
    <section
      class="splide event-carousel"
      id="event-carousel"
      aria-labelledby="gallery-title"
      tabindex="0"
    >
      <div class="splide__track">
        <ul class="splide__list">
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-presenting.webp"
                width="1800"
                height="1013"
                alt={copy.imageAlts[0]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-conversation.webp"
                width="1800"
                height="1200"
                alt={copy.imageAlts[1]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-demo-visitor.webp"
                width="1800"
                height="1200"
                alt={copy.imageAlts[2]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-guided-tour.webp"
                width="1280"
                height="720"
                alt={copy.imageAlts[3]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-fiec-team.webp"
                width="1800"
                height="1350"
                alt={copy.imageAlts[4]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-moldia-team.webp"
                width="1800"
                height="1200"
                alt={copy.imageAlts[5]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-unifor-team.webp"
                width="1800"
                height="1180"
                alt={copy.imageAlts[6]}
                loading="lazy"
              />
            </div>
          </li>
          <li class="splide__slide event-card">
            <div class="event-image">
              <img
                src="/assets/event-team.webp"
                width="1800"
                height="1200"
                alt={copy.imageAlts[7]}
                loading="lazy"
              />
            </div>
          </li>
        </ul>
      </div>
      <div class="gallery-pagination" aria-label={copy.controlsLabel} hidden>
        <button
          class="gallery-toggle"
          type="button"
          aria-label={copy.pause}
          aria-pressed="false"
          data-label-pause={copy.pause}
          data-label-play={copy.play}
        >
          <svg class="pause-icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <svg class="play-icon" viewBox="0 0 16 16" aria-hidden="true">
            <path d="m5 3 7 5-7 5z" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span class="gallery-toggle-label">{copy.pause}</span>
        </button>
      </div>
    </section>
  </div>
</section>

<script src="../../scripts/event-gallery.js"></script>
