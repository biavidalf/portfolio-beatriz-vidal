---
import QuickEmail from '../QuickEmail.astro';
import { getLocalizedContent, defaultLocale, type Locale } from '../../i18n/types';
import { homeCopy } from '../../content/home-copy';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const { contact: copy } = getLocalizedContent(homeCopy, locale);
---

<section class="contact-cta page-wrap" id="contato" aria-label={copy.ariaLabel}>
  <QuickEmail locale={locale} />
</section>

<script>
  import { setupScrollReveal } from '../../scripts/reveal.js';
  setupScrollReveal([['.contact-cta', 0]], document);
</script>
