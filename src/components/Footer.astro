---
interface Props {
  page: 'home' | 'trajectory';
}

const { page } = Astro.props;
---

<footer class="footer wrap">
  {page === 'home' ? (
    <p class="footer-brand"><img class="brand-icon" src="/assets/true-north-icon.ico" width="20" height="22" alt=""><span class="brand-name">beatriz.<em>vidal</em></span></p>
  ) : (
    <a class="footer-brand" href="/#inicio"><img class="brand-icon" src="/assets/true-north-icon.ico" width="20" height="22" alt=""><span class="brand-name">beatriz.<em>vidal</em></span></a>
  )}
  <p>Feito com intenção, de Fortaleza.<span class="footer-year">2026</span></p>
</footer>
