---
import '../styles/quick-email.css';
import { getLocalizedContent, defaultLocale, type Locale } from '../i18n/types';
import { quickContactCopy } from '../content/quick-contact';

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const directDelivery = import.meta.env.PUBLIC_CONTACT_DIRECT_ENABLED === 'true';
const copy = getLocalizedContent(quickContactCopy, locale);
---

<aside class="quick-email-card" aria-labelledby="quick-email-title">
  <div class="quick-email-copy">
    <p class="eyebrow quick-email-kicker">{copy.kicker}</p>
    <h3 id="quick-email-title">
      {copy.titleFirst} <em>{copy.titleEmphasis}</em>
    </h3>
    <p class="quick-email-intro" id="quick-contact-intro">
      {copy.introduction}
    </p>
  </div>
  <form
    id="quick-email-form"
    data-mode="whatsapp"
    data-direct-delivery={String(directDelivery)}
    data-copy={JSON.stringify(copy)}
  >
    <div class="quick-contact-modes" role="group" aria-label={copy.modesLabel}>
      <button
        class="quick-contact-mode is-active"
        type="button"
        data-contact-mode="whatsapp"
        aria-pressed="true"
      >
        {copy.whatsappLabel}
      </button>
      <button
        class="quick-contact-mode"
        type="button"
        data-contact-mode="email"
        aria-pressed="false"
      >
        {copy.emailLabel}
      </button>
    </div>
    <label class="quick-email-message-label" for="quick-email-message">
      {copy.messageLabel} <span>{copy.editHint}</span>
    </label>
    <textarea
      id="quick-email-message"
      name="message"
      rows="4"
      required
      maxlength="1000"
      aria-describedby="quick-email-help quick-email-status"
    >{copy.initialMessage}</textarea>
    <div class="quick-email-address-field" id="quick-email-address-field" hidden>
      <label for="quick-email-address">{copy.emailAddressLabel}</label>
      <input
        id="quick-email-address"
        name="email"
        type="email"
        placeholder={copy.emailPlaceholder}
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        aria-describedby="quick-email-help quick-email-status"
        disabled
      />
    </div>
    <button class="quick-contact-submit" type="submit">
      <span class="quick-contact-submit-label">{copy.submitWhatsapp}</span>
      <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
    </button>
    <div class="quick-email-trap" aria-hidden="true">
      <label for="quick-email-website">{copy.websiteLabel}</label>
      <input id="quick-email-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <p class="quick-email-help" id="quick-email-help">
      {copy.whatsappHelp}
    </p>
    <p class="quick-email-status" id="quick-email-status" role="status" aria-live="polite"></p>
  </form>
</aside>

<script>
  const form = document.querySelector<HTMLFormElement>('#quick-email-form');
  const emailField = form?.querySelector<HTMLElement>('#quick-email-address-field');
  const input = form?.querySelector<HTMLInputElement>('#quick-email-address');
  const messageInput = form?.querySelector<HTMLTextAreaElement>('#quick-email-message');
  const trap = form?.querySelector<HTMLInputElement>('#quick-email-website');
  const status = form?.querySelector<HTMLElement>('#quick-email-status');
  const help = form?.querySelector<HTMLElement>('#quick-email-help');
  const intro = document.querySelector<HTMLElement>('#quick-contact-intro');
  const submit = form?.querySelector<HTMLButtonElement>('.quick-contact-submit');
  const submitLabel = submit?.querySelector<HTMLElement>('.quick-contact-submit-label');
  const modeButtons = form?.querySelectorAll<HTMLButtonElement>('[data-contact-mode]');
  const directDelivery = form?.dataset.directDelivery === 'true';
  const copy = JSON.parse(form?.dataset.copy ?? '{}') as {
    introduction: string;
    emailIntroduction: string;
    submitWhatsapp: string;
    submitEmail: string;
    whatsappHelp: string;
    emailHelp: string;
    directEmailHelp: string;
    messageRequired: string;
    whatsappOpened: string;
    openingEmail: string;
    sending: string;
    sent: string;
    directFailed: string;
    emailSubject: string;
  };

  modeButtons?.forEach((button) =>
    button.addEventListener('click', () => {
      if (!form || !emailField || !input || !submitLabel || !help || !intro || !status) return;
      const mode = button.dataset.contactMode;
      if (mode === form.dataset.mode) return;
      form.dataset.mode = mode;
      modeButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      const emailMode = mode === 'email';
      emailField.hidden = !emailMode;
      input.disabled = !emailMode;
      input.required = emailMode;
      intro.textContent = emailMode ? copy.emailIntroduction : copy.introduction;
      submitLabel.textContent = emailMode ? copy.submitEmail : copy.submitWhatsapp;
      help.textContent = emailMode
        ? directDelivery
          ? copy.directEmailHelp
          : copy.emailHelp
        : copy.whatsappHelp;
      status.textContent = '';
    }),
  );
  function openEmailDraft(address: string, message: string) {
    const body = `${message}\n\nMeu e-mail para resposta: ${address}`;
    const subject = copy.emailSubject;
    window.location.href = `mailto:beatrizvidal.dev@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!messageInput || !status || !submit || !form.reportValidity()) return;
    if (trap?.value) return;
    const message = messageInput.value.trim();
    if (!message) {
      messageInput.setCustomValidity(copy.messageRequired);
      messageInput.reportValidity();
      return;
    }

    if (form.dataset.mode === 'whatsapp') {
      const url = new URL('https://web.whatsapp.com/send');
      url.searchParams.set('phone', '5585997008387');
      url.searchParams.set('text', message);
      window.open(url.toString(), '_blank', 'noopener,noreferrer');
      status.textContent = copy.whatsappOpened;
      return;
    }

    if (!input) return;
    const email = input.value.trim();
    if (!directDelivery) {
      status.textContent = copy.openingEmail;
      openEmailDraft(email, message);
      return;
    }

    submit.disabled = true;
    status.textContent = copy.sending;
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, message, website: trap?.value ?? '' }),
      });
      if (!response.ok) throw new Error('Falha no envio');
      form.reset();
      status.textContent = copy.sent;
    } catch {
      status.textContent = copy.directFailed;
      openEmailDraft(email, message);
    } finally {
      submit.disabled = false;
    }
  });
  messageInput?.addEventListener('input', () => messageInput.setCustomValidity(''));
</script>
