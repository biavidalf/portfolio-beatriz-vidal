---
import '../styles/work-method.css';
import { getLocalizedContent, defaultLocale, type Locale } from '../i18n/types';
import { workMethodCopy } from '../content/work-method';

interface Props {
  locale?: Locale;
}
const { locale = defaultLocale } = Astro.props;
const copy = getLocalizedContent(workMethodCopy, locale);
---

<script>
  const section = document.querySelector<HTMLElement>('.work-method');
  if (
    section &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const targets = section.querySelectorAll<HTMLElement>('[data-method-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -16px 0px' },
    );
    section.classList.add('method-motion-ready');
    targets.forEach((target) => {
      observer.observe(target);
      target.addEventListener('focusin', () => target.classList.add('is-visible'), { once: true });
    });

    const track = section.querySelector<HTMLElement>('.method-track-shell');
    const fill = track?.querySelector<HTMLElement>('.method-rail-fill');
    const steps = track?.querySelectorAll<HTMLElement>('.method-step');
    if (track && fill && steps) {
      const stepObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            stepObserver.unobserve(entry.target);
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
      );
      section.classList.add('method-scroll-ready');
      steps.forEach((step) => stepObserver.observe(step));

      let progressFrame = 0;
      const updateProgress = () => {
        progressFrame = 0;
        const rect = track.getBoundingClientRect();
        const progress = Math.max(
          0,
          Math.min(1, (window.innerHeight * 0.58 - rect.top) / rect.height),
        );
        fill.style.height = `${progress * 100}%`;
      };
      const queueProgress = () => {
        if (progressFrame) return;
        progressFrame = window.requestAnimationFrame(updateProgress);
      };
      window.addEventListener('scroll', queueProgress, { passive: true });
      window.addEventListener('resize', queueProgress);
      updateProgress();
    }
  } else {
    section?.querySelectorAll('.method-step').forEach((step) => step.classList.add('is-visible'));
  }
</script>

<section
  class="work-method page-wrap pt-[105px] md:pt-[75px] max-sm:pt-[65px]"
  id="como-trabalho"
  aria-labelledby="method-title"
>
  <div class="method-card">
    <div class="method-heading" data-method-reveal>
      <p class="eyebrow">{copy.eyebrow}</p>
      <div class="method-heading-grid">
        <h2 id="method-title">
          {copy.titleFirst}
          <br />
          <em>{copy.titleSecond}</em>
        </h2>
        <p class="method-intro">{copy.introduction}</p>
      </div>
    </div>

    <div class="method-workbench" data-method-reveal>
      <div class="method-principle">
        <p class="eyebrow">
          <span class="method-signal" aria-hidden="true"></span> {copy.roleLabel}
        </p>
        <h3>
          {copy.roleTitleFirst}
          <br />
          <em>{copy.roleTitleSecond}</em>
        </h3>
        <p class="method-principle-teaser">{copy.roleTeaser}</p>
        <p class="method-principle-content">{copy.roleDescription}</p>
        <a
          class="text-link"
          style="hover-"
          href="https://www.linkedin.com/in/beatriz-vidal-bf4/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.linkedin} <span class="icon icon-arrow-up-right" aria-hidden="true"></span>
        </a>
      </div>

      <div class="method-process" aria-label={copy.processTitle}>
        <p class="method-process-label eyebrow">{copy.processLabel}</p>
        <div class="method-track-shell">
          <span class="method-rail" aria-hidden="true">
            <span class="method-rail-fill"></span>
          </span>
          <ol class="method-steps">
            {copy.steps.map((step, index) => (
              <li class="method-step">
                <span class="method-step-marker" aria-hidden="true"></span>
                <span class="method-step-number" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="method-step-heading">
                  <strong>{step.title}</strong>
                  <p>{step.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>
