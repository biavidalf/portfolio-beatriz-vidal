---
import type { ProjectSummary } from '../content/projects';

interface Props {
  project: ProjectSummary;
}

const { project } = Astro.props;
---

<details class="work-accordion">
  <summary class="accordion-trigger">
    <span class="project-number" aria-hidden="true">
      {project.number}
    </span>
    <span class="accordion-title">
      <span class="accordion-title-line">
        <strong>{project.title}</strong>
        <span class="company-badge">{project.company}</span>
      </span>
      <small>{project.subtitle}</small>
      <span class="project-tag-list project-tag-list-compact" aria-label={project.tagLabel}>
        {project.tags.map((tag: string, index: number) => (
          <span class:list={['project-tag', { 'project-tag-primary': index === 0 }]}>{tag}</span>
        ))}
      </span>
    </span>
    <span class="accordion-summary">{project.summary}</span>
    <span class="accordion-toggle" aria-hidden="true"></span>
  </summary>
  <div class="accordion-content">
    <slot />
  </div>
</details>
