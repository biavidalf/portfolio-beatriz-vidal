# A prévia local abre o aplicativo de e-mail com a mensagem pronta.
PUBLIC_CONTACT_DIRECT_ENABLED=false

# Para habilitar envio direto depois da revisão, configure estas variáveis na Vercel.
# CONTACT_FROM_EMAIL precisa ser um remetente verificado no serviço de e-mail.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
